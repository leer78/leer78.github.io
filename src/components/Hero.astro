---

<section class="hero" id="Home">
  <div class="hero-inner">
    <h1 class="page-title">Ryan Lee</h1>
    <hr />
    <p class="tagline">I like to build things.</p>
  </div>
</section>

<style>
  .hero {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/background.jpg') center/cover no-repeat;
    z-index: 0;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.15);
    z-index: 1;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
  }

  .page-title {
    font-size: clamp(3rem, 6vw, 5rem);
    color: black;
  }

  .hero-inner hr {
    width: 300px;
    border: none;
    border-top: 1px solid black;
    margin: 1rem auto;
  }

  .tagline {
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    color: black;
    font-weight: 400;
  }
</style>
