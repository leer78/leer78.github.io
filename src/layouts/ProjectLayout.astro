---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, subtitle, year, tags, github, youtube } = project.data;

function getYouTubeEmbedUrl(url?: string) {
  if (!url) {
    return null;
  }

  try {
    const parsed = new URL(url);
    let videoId = '';

    if (parsed.hostname.includes('youtu.be')) {
      videoId = parsed.pathname.slice(1);
    } else if (parsed.pathname.includes('/embed/')) {
      videoId = parsed.pathname.split('/embed/')[1]?.split('/')[0] ?? '';
    } else {
      videoId = parsed.searchParams.get('v') ?? '';
    }

    return videoId ? `https://www.youtube.com/embed/${videoId}` : null;
  } catch {
    return null;
  }
}

const youtubeEmbedUrl = getYouTubeEmbedUrl(youtube);
---

<BaseLayout title={`${title} — Ryan Lee`}>
  <div class="project-shell">
    <div class="project-page">
      <header class="project-header">
        <a href="/#Projects" class="back-link">← Back to Projects</a>
        <h1>{title}</h1>
        {subtitle && <p class="subtitle">{subtitle}</p>}
        <span class="year">{year}</span>
        <div class="tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <div class="links">
          {github && <a href={github} target="_blank" class="ext-link">GitHub ↗</a>}
        </div>

        {youtubeEmbedUrl && (
          <div class="video-preview">
            <iframe
              src={youtubeEmbedUrl}
              title={`${title} video preview`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        )}
      </header>

      <article class="project-content">
        <slot />
      </article>

      <footer class="project-footer">
        <a href="/#Projects">← Back to all projects</a>
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  .project-shell {
    min-height: 100vh;
    background: #ffffff;
    padding: 0 0 3rem;
  }

  .project-page {
    width: min(99.2%, 1600px);
    min-height: 100vh;
    margin: 0 auto;
    padding: 2rem;
    background: #ececec;
  }

  .project-header {
    max-width: 920px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #d2ccc2;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: #6d675f;
  }

  .back-link:hover {
    color: var(--accent);
  }

  h1 {
    font-size: 2.2rem;
    font-weight: 400;
    color: #1f1d1a;
    margin-bottom: 0.3rem;
  }

  .subtitle {
    color: var(--accent);
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .year {
    color: #6d675f;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    display: block;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 2px 8px;
    font-family: var(--font-mono);
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .ext-link {
    font-size: 0.85rem;
    color: #5e5851;
    padding: 0.3rem 0.8rem;
    border: 1px solid #cfc9bf;
    border-radius: 4px;
  }

  .ext-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  .video-preview {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    margin: 1.5rem auto 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    display: flex;
    justify-content: center;
    background: #000;
  }

  .video-preview iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .project-content {
    max-width: 920px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .project-content :global(h2) {
    font-size: 1.5rem;
    color: var(--accent);
    margin-top: 2.5rem;
    margin-bottom: 0.8rem;
  }

  .project-content :global(h3) {
    font-size: 1.2rem;
    color: #1f1d1a;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .project-content :global(h4) {
    font-size: 1rem;
    color: #2d2a25;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-content :global(p) {
    color: #4f4a44;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .project-content :global(ul), .project-content :global(ol) {
    margin: 0.5rem 0 1rem 1.5rem;
    color: #4f4a44;
    font-size: 0.95rem;
  }

  .project-content :global(li) {
    margin-bottom: 0.3rem;
  }

  .project-content :global(img) {
    display: block;
    border-radius: 8px;
    margin: 1rem 0;
    border: 1px solid #d2ccc2;
  }

  .project-content :global(figure) {
    margin: 1rem 0;
    text-align: center;
  }

  .project-content :global(figcaption) {
    font-size: 0.92rem;
    color: #6d675f;
    margin-top: 0.1rem;
    line-height: 1.35;
    font-style: italic;
  }

  .project-content :global(.image-row) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 240px));
    justify-content: center;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .project-content :global(.image-row-four) {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
  }

  .project-content :global(.image-row-four figure) {
    margin: 0;
  }

  .project-content :global(.image-row img) {
    width: 100%;
    margin: 0;
  }

  .project-content :global(.image-large) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .project-content :global(.image-large figure) {
    margin: 0;
  }

  .project-content :global(.image-large img) {
    width: auto;
    max-width: 100%;
    max-height: 260px;
    margin: 0;
  }

  .project-content :global(iframe) {
    width: 100%;
    aspect-ratio: 16/9;
    border: none;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .project-footer {
    max-width: 920px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #d2ccc2;
    text-align: center;
  }

  .project-footer a {
    color: #6d675f;
    font-size: 0.9rem;
  }

  .project-footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .project-content :global(.image-row-four) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
